# Supabase PostgreSQL connection
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxx:password@aws-0-region.supabase.com:5432/postgres"

# JWT Secret (Generate dengan: openssl rand -hex 32)
JWT_SECRET="GANTI_DENGAN_HASIL_openssl_rand_-hex_32"

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="mykost-storage"
R2_PUBLIC_DOMAIN="https://pub-xxx.r2.dev"

# Fonnte WhatsApp API Gateway Token
FONNTE_API_TOKEN="your-fonnte-token-here"

# Cron Secret Token
CRON_SECRET="your-cron-secret-token"
