# Supabase PostgreSQL connection
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxx:password@aws-0-region.supabase.com:5432/postgres"

# JWT Secret
JWT_SECRET="super-secret-jwt-key-change-in-production-123456"

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="mykost-storage"
R2_PUBLIC_DOMAIN="https://pub-xxx.r2.dev"

# Fonnte WhatsApp API Token
FONNTE_API_TOKEN="your-fonnte-token"
