datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  PENGHUNI
}

enum StatusKamar {
  KOSONG
  TERISI
  BOOKING
  MAINTENANCE
}

enum StatusKontrak {
  AKTIF
  SELESAI
  DIBATALKAN
}

enum StatusTagihan {
  BELUM_BAYAR
  SEBAGIAN
  LUNAS
  TERLAMBAT
}

enum StatusVerifikasi {
  PENDING
  DISETUJUI
  DITOLAK
}

enum StatusPengaduan {
  BARU
  DIPROSES
  SELESAI
}

enum DendaMode {
  HARIAN
  TETAP
}

model User {
  id            String   @id @default(cuid())
  nama          String
  email         String   @unique
  password_hash String
  role          Role     @default(PENGHUNI)
  token_version Int      @default(0)
  foto_url      String?
  no_hp         String?
  created_at    DateTime @default(now())

  properti     Properti[]
  penghuni     Penghuni?
  logAktivitas LogAktivitas[]
  notifikasi   Notifikasi[]
}

model Properti {
  id         String   @id @default(cuid())
  nama       String
  alamat     String
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  created_at DateTime @default(now())

  kamar Kamar[]
}

model Kamar {
  id          String      @id @default(cuid())
  properti_id String
  properti    Properti    @relation(fields: [properti_id], references: [id], onDelete: Cascade)
  nomor_kamar String
  tipe        String
  lantai      Int?
  harga_sewa  Decimal     @db.Decimal(12, 2)
  status      StatusKamar @default(KOSONG)
  fasilitas   String
  foto_url    String?

  kontrak   Kontrak[]
  pengaduan Pengaduan[]

  @@unique([properti_id, nomor_kamar])
}

model Penghuni {
  id                  String   @id @default(cuid())
  user_id             String?  @unique
  user                User?    @relation(fields: [user_id], references: [id])
  nama                String
  no_ktp              String
  no_hp               String   @unique
  email               String
  foto_ktp_url        String?
  kontak_darurat_nama String?
  kontak_darurat_hp   String?
  created_at          DateTime @default(now())

  kontrak        Kontrak[]
  pengaduan      Pengaduan[]
  aktivasiTokens AktivasiToken[]
}

model Kontrak {
  id                    String        @id @default(cuid())
  kamar_id              String
  kamar                 Kamar         @relation(fields: [kamar_id], references: [id])
  penghuni_id           String
  penghuni              Penghuni      @relation(fields: [penghuni_id], references: [id])
  tanggal_mulai         DateTime
  tanggal_selesai       DateTime
  harga_sewa_disepakati Decimal       @db.Decimal(12, 2)
  deposit_awal          Decimal?      @db.Decimal(12, 2)
  potongan_deposit      Decimal?      @db.Decimal(12, 2)
  catatan_potongan      String?
  tanggal_checkout      DateTime?
  status                StatusKontrak @default(AKTIF)
  dokumen_url           String?

  tagihan Tagihan[]

  @@index([status])
}

model Tagihan {
  id                     String        @id @default(cuid())
  kontrak_id             String
  kontrak                Kontrak       @relation(fields: [kontrak_id], references: [id])
  periode                String        // e.g. "2026-10"
  jumlah                 Decimal       @db.Decimal(12, 2)
  denda                  Decimal       @default(0) @db.Decimal(12, 2)
  jatuh_tempo            DateTime
  status                 StatusTagihan @default(BELUM_BAYAR)
  terakhir_diingatkan_at DateTime?
  created_at             DateTime      @default(now())

  pembayaran Pembayaran[]

  @@unique([kontrak_id, periode])
  @@index([status, jatuh_tempo])
}

model Pembayaran {
  id                String           @id @default(cuid())
  tagihan_id        String
  tagihan           Tagihan          @relation(fields: [tagihan_id], references: [id])
  jumlah_dibayar    Decimal          @db.Decimal(12, 2)
  metode            String
  tanggal_bayar     DateTime         @default(now())
  bukti_url         String
  status_verifikasi StatusVerifikasi @default(PENDING)
  diverifikasi_oleh String?
  diverifikasi_at   DateTime?

  @@index([status_verifikasi])
}

model Pengaduan {
  id               String          @id @default(cuid())
  kamar_id         String
  kamar            Kamar           @relation(fields: [kamar_id], references: [id])
  penghuni_id      String
  penghuni         Penghuni        @relation(fields: [penghuni_id], references: [id])
  kategori         String
  deskripsi        String
  foto_url         Json?           // Array of image URLs
  status           StatusPengaduan @default(BARU)
  catatan_internal String?
  created_at       DateTime        @default(now())
  resolved_at      DateTime?

  @@index([status])
}

model LogAktivitas {
  id        String   @id @default(cuid())
  user_id   String
  user      User     @relation(fields: [user_id], references: [id])
  aksi      String
  detail    String
  timestamp DateTime @default(now())

  @@index([timestamp(sort: Desc)])
}

model Pengaturan {
  id                  String    @id @default("default")
  harga_default       Decimal   @default(1500000) @db.Decimal(12, 2)
  denda_per_hari      Decimal   @default(50000) @db.Decimal(12, 2)
  denda_mode          DendaMode @default(HARIAN)
  batas_reminder_hari Int       @default(3)
  wa_template         String    @default("Halo Sdr/i {NAMA}, Tagihan sewa kamar {KAMAR} periode {PERIODE} sebesar {JUMLAH} akan jatuh tempo pada {JATUH_TEMPO}.") @db.Text
  bank_nama           String?
  bank_no_rekening    String?
  bank_atas_nama      String?
  kontak_pengelola_wa String?
  updated_at          DateTime  @updatedAt
}

model Notifikasi {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  judul      String
  pesan      String
  tipe       String   @default("UMUM")
  dibaca     Boolean  @default(false)
  created_at DateTime @default(now())
}

model AktivasiToken {
  id          String    @id @default(cuid())
  penghuni_id String
  penghuni    Penghuni  @relation(fields: [penghuni_id], references: [id], onDelete: Cascade)
  token_hash  String    @unique
  tipe        String    @default("AKTIVASI") // AKTIVASI | RESET_PASSWORD
  expires_at  DateTime
  used_at     DateTime?
  created_at  DateTime  @default(now())

  @@index([token_hash])
  @@index([penghuni_id])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  key        String   @unique // ip:identifier
  attempts   Int      @default(1)
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([key])
  @@index([expires_at])
}
